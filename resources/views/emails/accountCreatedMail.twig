{% extends 'emails/layout' %}

{% block header %}{{ t('account_created.title') }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ t('greeting', {name: user.name}) }}</p>
<p style="margin:0;">{{ t('account_created.body', {app: settings.application_name}) }}</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}
{% block action_text %}{{ t('account_created.button') }}{% endblock %}
