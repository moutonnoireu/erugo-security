{% extends 'emails/layout' %}

{% block header %}{{ t('password_reset.title') }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ t('greeting', {name: user.name}) }}</p>
<p style="margin:0 0 12px;">{{ t('password_reset.body', {app: settings.application_name}) }}</p>
<p class="muted" style="margin:0;font-size:14px;color:#6b7370;">{{ t('password_reset.ignore') }}</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/reset-password/{{ token }}{% endblock %}
{% block action_text %}{{ t('password_reset.button') }}{% endblock %}
