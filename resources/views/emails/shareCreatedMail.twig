{% extends 'emails/layout' %}

{% block header %}{{ t('share_created.title') }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ t('greeting', {name: recipient_name}) }}</p>
<p style="margin:0;">{{ t('share_created.body', {sender: sender_name, count: share.file_count}) }}</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/shares/{{ share.long_id }}{% endblock %}
{% block action_text %}{{ t('share_created.button') }}{% endblock %}
