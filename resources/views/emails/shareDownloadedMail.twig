{% extends 'emails/layout' %}

{% block header %}{{ t('share_downloaded.title') }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ t('greeting', {name: share.user.name}) }}</p>
<p style="margin:0;">{{ t('share_downloaded.body', {share: share.name}) }}</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}/shares/{{ share.long_id }}{% endblock %}
{% block action_text %}{{ t('share_downloaded.button') }}{% endblock %}
