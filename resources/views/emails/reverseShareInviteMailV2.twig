{% extends 'emails/layout' %}

{% block header %}{{ t('reverse_share_invite.title', {sender: sender_name}) }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ t('greeting', {name: recipient_name}) }}</p>
{% if isExistingUser %}
<p style="margin:0;">{{ t('reverse_share_invite.body_existing', {sender: sender_name}) }}</p>
{% else %}
<p style="margin:0;">{{ t('reverse_share_invite.body_new', {sender: sender_name}) }}</p>
{% endif %}
{% if invite.message %}
<p class="muted" style="margin:20px 0 4px;font-size:14px;color:#59655f;">{{ t('reverse_share_invite.message', {sender: sender_name}) }}</p>
<p style="margin:0;font-style:italic;">{{ invite.message }}</p>
{% endif %}
{% endblock %}

{% block action_url %}{% if isExistingUser %}{{ settings.application_url }}/?invite_id={{ invite.id }}{% else %}{{ settings.application_url }}/?invite_token={{ token }}{% endif %}{% endblock %}

{% block action_text %}{% if isExistingUser %}{{ t('reverse_share_invite.button_existing') }}{% else %}{{ t('reverse_share_invite.button_new') }}{% endif %}{% endblock %}
