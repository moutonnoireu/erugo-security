{% extends 'emails/layout' %}

{% block header %}{{ t('share_expiry_warning.title', {delay: share_expires_in}) }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ t('greeting', {name: share.user.first_name}) }}</p>
<p style="margin:0;">{{ t('share_expiry_warning.body', {share: share.name, delay: share_expires_in}) }}</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}{% endblock %}
{% block action_text %}{{ t('share_expiry_warning.button', {app: settings.application_name}) }}{% endblock %}
