{% extends 'emails/layout' %}

{% block header %}{{ t('share_expired.title') }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ t('greeting', {name: share.user.first_name}) }}</p>
<p style="margin:0 0 12px;">{{ t('share_expired.body', {share: share.name}) }}</p>
<p class="muted" style="margin:0;font-size:14px;color:#59655f;">{% if share.download_count > 0 %}{{ t('downloaded', {count: share.download_count}) }}{% else %}{{ t('not_downloaded') }}{% endif %}</p>
{% endblock %}

{% block action_url %}{{ settings.application_url }}{% endblock %}
{% block action_text %}{{ t('share_expired.button', {app: settings.application_name}) }}{% endblock %}
