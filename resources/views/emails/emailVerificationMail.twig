{% extends 'emails/layout' %}

{% block header %}{{ t('email_verification.title') }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ t('greeting', {name: user.name}) }}</p>
<p style="margin:0 0 20px;">{{ t('email_verification.body', {app: settings.application_name}) }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 12px;">
	<tr>
		<td align="center" bgcolor="#eef1f0" style="background-color:#eef1f0;border:1px solid #cfd6d2;border-radius:4px;padding:14px 28px;font-family:Consolas,'Courier New',monospace;font-size:30px;font-weight:700;letter-spacing:8px;color:#14201d;">{{ code }}</td>
	</tr>
</table>
<p class="muted" style="margin:0 0 4px;font-size:14px;color:#59655f;">{{ t('email_verification.expires') }}</p>
<p class="muted" style="margin:0;font-size:14px;color:#59655f;">{{ t('email_verification.ignore') }}</p>
{% endblock %}
