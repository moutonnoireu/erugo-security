{% extends 'emails/layout' %}

{% block header %}{{ t('email_verification.title') }}{% endblock %}

{% block content %}
<p style="margin:0 0 12px;">{{ t('greeting', {name: user.name}) }}</p>
<p style="margin:0 0 20px;">{{ t('email_verification.body', {app: settings.application_name}) }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 14px;">
	<tr>
		<td align="center" bgcolor="#f3f4f6" style="background-color:#f3f4f6;border:1px solid #e0e3e2;border-radius:3px;padding:12px 24px;color:#222222;font-family:Consolas,'Courier New',monospace;font-size:28px;font-weight:700;letter-spacing:6px;">{{ code }}</td>
	</tr>
</table>
<p class="muted" style="margin:0 0 4px;font-size:14px;color:#6b7370;">{{ t('email_verification.expires') }}</p>
<p class="muted" style="margin:0;font-size:14px;color:#6b7370;">{{ t('email_verification.ignore') }}</p>
{% endblock %}
