<!DOCTYPE html>
<html lang="{{ brand.lang|default('en') }}" xmlns="http://www.w3.org/1999/xhtml">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="color-scheme" content="light dark">
		<meta name="supported-color-schemes" content="light dark">
		<title>{% block title %}{{ block('header')|striptags|trim }}{% endblock %}</title>
		<style>
			body { margin: 0; padding: 0; background-color: #eef1f0; }
			table { border-collapse: collapse; }
			img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
			a { color: {{ brand.accent|default('#1f5a6e') }}; }
			@media only screen and (max-width: 620px) {
				.wrap { width: 100% !important; }
				.pad { padding-left: 20px !important; padding-right: 20px !important; }
				.title { font-size: 21px !important; }
			}
			@media (prefers-color-scheme: dark) {
				body, .outer { background-color: #101514 !important; }
				.card { background-color: #1a2120 !important; border-color: #35413f !important; }
				.title, .text { color: #e8eeec !important; }
				.muted { color: #a4b2ad !important; }
				.rule { border-color: #35413f !important; }
			}
		</style>
	</head>
	<body style="margin:0;padding:0;background-color:#eef1f0;">
		<table role="presentation" class="outer" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef1f0;">
			<tr>
				<td align="center" style="padding:28px 12px;">
					<table role="presentation" class="wrap" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px;max-width:100%;">
						<tr>
							<td align="center" bgcolor="{{ brand.plate|default('#ffffff') }}" style="background-color:{{ brand.plate|default('#ffffff') }};padding:20px 24px;border:1px solid #d3d9d5;border-bottom:0;font-family:'Segoe UI',Helvetica,Arial,sans-serif;font-size:17px;font-weight:600;line-height:1.3;color:{{ brand.plate_ink|default('#14201d') }};">
								{% if brand.logo_url %}
									<img src="{{ brand.logo_url }}" alt="{{ brand.name }}" height="44" style="display:block;margin:0 auto;height:44px;width:auto;max-width:100%;">
								{% else %}
									{{ brand.name }}
								{% endif %}
							</td>
						</tr>
						<tr>
							<td class="card pad" align="center" bgcolor="#ffffff" style="background-color:#ffffff;border:1px solid #d3d9d5;border-top:3px solid {{ brand.accent|default('#1f5a6e') }};padding:36px 40px 32px;font-family:'Segoe UI',Helvetica,Arial,sans-serif;">
								<h1 class="title" style="margin:0 0 16px;font-size:24px;line-height:1.3;font-weight:600;color:#14201d;">{% block header %}{% endblock %}</h1>
								<div class="text" style="font-size:16px;line-height:1.6;color:#27312e;text-align:center;">
									{% block content %}{% endblock %}
								</div>
								{% if block('action_url') is defined %}
									<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:28px auto 0;">
										<tr>
											<td align="center" bgcolor="{{ brand.accent|default('#1f5a6e') }}" style="background-color:{{ brand.accent|default('#1f5a6e') }};border-radius:4px;">
												<a href="{{ block('action_url')|trim }}" style="display:inline-block;padding:14px 28px;font-family:'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:1.2;color:{{ brand.accent_ink|default('#ffffff') }};text-decoration:none;border-radius:4px;">{{ block('action_text')|trim }}</a>
											</td>
										</tr>
									</table>
									<p class="muted" style="margin:24px 0 4px;font-size:13px;line-height:1.5;color:#59655f;">{{ t('fallback') }}</p>
									<p class="muted" style="margin:0;font-size:13px;line-height:1.5;color:#59655f;word-break:break-all;"><a href="{{ block('action_url')|trim }}" style="color:#59655f;text-decoration:underline;">{{ block('action_url')|trim }}</a></p>
								{% endif %}
							</td>
						</tr>
						<tr>
							<td class="muted" align="center" style="padding:16px 24px 0;font-family:'Segoe UI',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:1.5;color:#59655f;">
								{{ brand.name }}<br>{{ t('automatic') }}
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
