#!/bin/sh
# Erugo container entrypoint.
#
# Started as root (the default), it only fixes the ownership of the storage
# volume, then re-runs itself as the unprivileged erugo user. Started directly
# as erugo (`user: "1000:1000"`), it skips that step: the volume must then
# already belong to uid 1000.

banner() {
echo "Erugo is starting..."
echo "================================================"

cat << 'EOF'
██████████████    ████████  █████████████    █████ █████████████  █████████  
   ███        ████ █████████████████████████    ████████████████████████████████
    ████      █████████    ██████████  █████    █████████     █████████     ████
     ████     ██████████████████████   █████    █████████     ████████      ████
   ████   ██  █████████        █████   █████    █████████     █████████     ████
 ████   ██████████ █████████████████    ████████████████████████████████████████
███   ████  █████   ██████████ █████    █████████████ █████████████ ██████████  
████████                                                       ████              
 ██████                                              █████████████              
                                                      ██████████                

█████████████████████████████████████████████████████████████████████████████████
EOF

echo "https://erugo.app"
echo "================================================"
}

if [ "$(id -u)" = "0" ]; then
    banner
    mkdir -p /var/www/html/storage
    echo "Setting storage permissions..."
    # only touch what is not already owned by erugo (fast on large volumes)
    find /var/www/html/storage \( ! -user erugo -o ! -group erugo \) -exec chown -h erugo:erugo {} +
    # the container runtime gives stdout/stderr to root: hand them to erugo so
    # supervisord can still send every program's output to `docker logs`
    chown erugo:erugo /proc/self/fd/1 /proc/self/fd/2 2>/dev/null || true
    export ERUGO_BANNER_SHOWN=1
    exec su-exec erugo:erugo "$0" "$@"
fi

[ -n "$ERUGO_BANNER_SHOWN" ] || banner

if [ ! -w /var/www/html/storage ]; then
    echo "ERROR: /var/www/html/storage is not writable by uid $(id -u)." >&2
    echo "Mount a volume there owned by 1000:1000, or start the container as root once to fix it." >&2
    exit 1
fi

cd /var/www/html
export ERUGO_PORT="${ERUGO_PORT:-80}"
# keys, database and uploads are not readable by other users of the container
umask 0027

export APP_URL=/
export ASSET_URL=/

# Increment patch version to account for Komodo's pre-increment tagging
# Handles formats like: 0.0.18, v1.2.3, RC 0.0.18
if [ -n "$APP_VERSION" ] && [ "$APP_VERSION" != "unknown" ]; then
    # Extract the version number part (last occurrence of X.Y.Z pattern)
    VERSION_NUM=$(echo "$APP_VERSION" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | tail -1)
    
    if [ -n "$VERSION_NUM" ]; then
        # Split into major.minor.patch
        MAJOR=$(echo "$VERSION_NUM" | cut -d. -f1)
        MINOR=$(echo "$VERSION_NUM" | cut -d. -f2)
        PATCH=$(echo "$VERSION_NUM" | cut -d. -f3)
        
        # Increment patch
        NEW_PATCH=$((PATCH + 1))
        NEW_VERSION_NUM="${MAJOR}.${MINOR}.${NEW_PATCH}"
        
        # Replace the old version number with the new one in the full string
        export APP_VERSION=$(echo "$APP_VERSION" | sed "s/${VERSION_NUM}/${NEW_VERSION_NUM}/")
        echo "Version: $APP_VERSION"
    fi
fi

# First time setup check
if [ ! -f /var/www/html/storage/.setup-lock ]; then
    echo "[First time setup] Copying storage skeleton contents..."
    rm -rf /var/www/html/storage/*
    cp -r /var/www/html/storage_skell/* /var/www/html/storage/
    touch /var/www/html/storage/.setup-lock
else
    echo "Setup already completed, skipping..."
    
    # Ensure new directories exist for upgrades from older versions
    mkdir -p /var/www/html/storage/app/backgrounds/cache/thumbs
    mkdir -p /var/www/html/storage/app/public/images
    
    # Copy default logo files if they don't exist (for upgrades)
    if [ ! -f /var/www/html/storage/app/public/images/_default-logo.png ]; then
        cp /var/www/html/storage_skell/app/public/images/_default-logo.png /var/www/html/storage/app/public/images/
    fi
    if [ ! -f /var/www/html/storage/app/public/images/logo.png ]; then
        cp /var/www/html/storage_skell/app/public/images/logo.png /var/www/html/storage/app/public/images/
    fi
    
    # Copy default background files if they don't exist (for upgrades)
    if [ ! -f /var/www/html/storage/app/public/images/_default-background.jpg ]; then
        cp /var/www/html/storage_skell/app/public/images/_default-background.jpg /var/www/html/storage/app/public/images/
    fi
    if [ ! -f /var/www/html/storage/app/public/images/default-background.jpg ]; then
        cp /var/www/html/storage_skell/app/public/images/default-background.jpg /var/www/html/storage/app/public/images/
    fi
fi

# if the app.key file exists, load its contents into the environment as APP_KEY, otherwise generate a new one
if [ -f /var/www/html/storage/app.key ]; then
    echo "App key already exists, loading..."
    export APP_KEY=$(cat /var/www/html/storage/app.key)
else
    # generate app key
    echo "Generating app key..."
    php artisan key:generate --force --show >/var/www/html/storage/app.key
    echo "App key generated, loading..."
    export APP_KEY=$(cat /var/www/html/storage/app.key)
fi

# if the jwt.secret file exists, load its contents into the environment as JWT_SECRET, otherwise generate a new one
if [ -f /var/www/html/storage/jwt.secret ]; then
    echo "JWT secret already exists, loading..."
    export JWT_SECRET=$(cat /var/www/html/storage/jwt.secret)
else
    echo "Generating JWT secret..."
    php -r "echo base64_encode(random_bytes(32));" >/var/www/html/storage/jwt.secret
    echo "JWT secret generated, loading..."
    export JWT_SECRET=$(cat /var/www/html/storage/jwt.secret)
fi

# does and environment variable DB_CONNECTION exist?
if [ -z "$DB_CONNECTION" ]; then
    echo "DB_CONNECTION environment variable not set, setting to sqlite..."
    export DB_CONNECTION=sqlite
    export DB_DATABASE=./storage/app/private/database.sqlite
fi

# Always run migrations
echo "Running migrations..."
php artisan migrate --force

echo "Running seeds..."
php artisan db:seed --force

echo "Clearing settings cache..."
php artisan clear-settings-cache

echo "Clearing templates cache..."
php artisan view:clear

# bootstrap/cache is read-only when the root filesystem is: the image ships
# a fresh package manifest and nothing else is cached there
if [ -w /var/www/html/bootstrap/cache ]; then
    echo "Clearing config cache..."
    php artisan config:clear

    echo "Clearing route cache..."
    php artisan route:clear

    echo "Clearing compiled classes..."
    php artisan clear-compiled
fi

echo "Updating legacy share paths..."
php artisan update-legacy-share-paths

# Migrate backgrounds from old storage location (storage/app/public/backgrounds) to new location (storage/app/backgrounds)
if [ -d /var/www/html/storage/app/public/backgrounds ] && [ "$(ls -A /var/www/html/storage/app/public/backgrounds 2>/dev/null)" ]; then
    echo "Migrating backgrounds from old storage location..."
    mkdir -p /var/www/html/storage/app/backgrounds/cache/thumbs
    # Copy files (not recursively overwriting existing)
    cp -rn /var/www/html/storage/app/public/backgrounds/* /var/www/html/storage/app/backgrounds/ 2>/dev/null || true
    # Remove old location after successful migration
    rm -rf /var/www/html/storage/app/public/backgrounds
    echo "Backgrounds migration complete."
fi

echo "Starting services..."
exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf